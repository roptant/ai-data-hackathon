{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Dictation",
  "version": "0.2.0",
  "identifier": "app.localdictation.desktop",
  "build": {
    "beforeBuildCommand": "sh scripts/build-ui.sh",
    "beforeDevCommand": "sh scripts/build-ui.sh",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Local Dictation",
        "url": "index.html",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Private local dictation",
    "longDescription": "Local speech recognition with optional, privacy-filtered personalization.",
    "externalBin": [
      "binaries/dictation-asr-worker",
      "binaries/dictation-privacy-worker"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/applications/app.localdictation.desktop.desktop": "linux/app.localdictation.desktop.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/applications/app.localdictation.desktop.desktop": "linux/app.localdictation.desktop.desktop"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}